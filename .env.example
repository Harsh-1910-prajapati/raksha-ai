# ============================================================================
# RakshaAI — root environment template
# Copy to .env where required and fill in values. NEVER commit real keys.
# ============================================================================

# --- Gemini (optional for live AI, REQUIRED for live reasoning) -------------
# Used for disaster-impact reasoning, emergency action planning, structured
# situation analysis and multilingual alert generation.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Google Maps (frontend, optional) ---------------------------------------
# Used for map visualization and infrastructure context.
# Set in frontend/.env.local as NEXT_PUBLIC_GOOGLE_MAPS_API_KEY
GOOGLE_MAPS_API_KEY=

# --- Google Earth Engine (optional) -----------------------------------------
# Used for geospatial/environmental data processing (elevation, etc.).
GOOGLE_CLOUD_PROJECT=
EARTH_ENGINE_PROJECT=
EARTH_ENGINE_SERVICE_ACCOUNT=
EARTH_ENGINE_ENABLED=0

# --- Firebase (optional repository backend) ---------------------------------
FIREBASE_PROJECT_ID=

# --- App -------------------------------------------------------------
ENVIRONMENT=development

# Comma-separated allowed CORS origins for the backend.
# Wildcards (e.g. https://*.vercel.app) are supported and compiled to a regex.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://raksha-ai.vercel.app,https://*.vercel.app

# --- Risk-engine weights (prototype, configurable) --------------------------
RISK_FLOOD_WEIGHT=0.30
RISK_WIND_WEIGHT=0.25
RISK_POPULATION_WEIGHT=0.20
RISK_INFRASTRUCTURE_WEIGHT=0.15
RISK_ACCESSIBILITY_WEIGHT=0.10